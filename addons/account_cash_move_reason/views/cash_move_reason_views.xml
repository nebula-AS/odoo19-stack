<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cash_move_reason_tree" model="ir.ui.view">
        <field name="name">account.cash.move.reason.list</field>
        <field name="model">account.cash.move.reason</field>
        <field name="arch" type="xml">
            <list string="Types d operation de caisse">
                <field name="name"/>
                <field name="move_type"/>
                <field name="account_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_cash_move_reason_form" model="ir.ui.view">
        <field name="name">account.cash.move.reason.form</field>
        <field name="model">account.cash.move.reason</field>
        <field name="arch" type="xml">
            <form string="Type d operation de caisse">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="move_type"/>
                        </group>
                        <group>
                            <field name="account_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_cash_move_reason" model="ir.actions.act_window">
        <field name="name">Types d operation de caisse</field>
        <field name="res_model">account.cash.move.reason</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_cash_move_reason"
              name="Types d operation de caisse"
              action="action_cash_move_reason"
              parent="account.menu_finance_configuration"
              sequence="100"/>
    <record id="view_account_payment_form_inherit_cash_reason" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.cash.reason</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_method_line_id']" position="after">
                <field name="cash_move_reason_id" options="{'no_create': True, 'no_open': True}"/>
            </xpath>
            <xpath expr="//group[@name='group1']" position="before">
                <div class="alert alert-info" role="alert"
                     invisible="not is_internal_transfer">
                    Un deuxieme paiement sera cree automatiquement dans le journal de destination.
                </div>
                <group name="group_transfer" col="2">
                    <field name="is_internal_transfer" string="Transfert interne" readonly="state != 'draft'"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="destination_journal_id"
                       invisible="not is_internal_transfer"
                       required="is_internal_transfer"
                       readonly="state != 'draft'"
                       options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Ecriture comptable" name="journal_items">
                        <field name="move_id" invisible="1"/>
                        <field name="ecriture_line_ids" readonly="1">
                            <list string="Lignes comptables" create="false" delete="false" edit="false">
                                <field name="account_id" string="Compte"/>
                                <field name="partner_id" string="Partenaire"/>
                                <field name="name" string="Libelle"/>
                                <field name="debit" string="Debit" sum="Total Debit"/>
                                <field name="credit" string="Credit" sum="Total Credit"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
    <record id="view_cash_payment_list" model="ir.ui.view">
        <field name="name">account.payment.cash.list</field>
        <field name="model">account.payment</field>
        <field name="arch" type="xml">
            <list string="Operations de caisse" create="true" delete="true">
                <field name="date"/>
                <field name="name"/>
                <field name="partner_id" string="Partenaire"/>
                <field name="memo" string="Libelle"/>
                <field name="journal_id" string="Caisse"/>
                <field name="compte_contrepartie_id" string="Compte"/>
                <field name="cash_move_reason_id" string="Type operation"/>
                <field name="payment_type" string="Type"/>
                <field name="amount" string="Montant" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'posted'"
                       decoration-warning="state == 'draft'"/>
            </list>
        </field>
    </record>
    <record id="action_cash_payments" model="ir.actions.act_window">
        <field name="name">Operations de caisse</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('journal_id.type', '=', 'cash')]</field>
        <field name="context">{
            'default_payment_type': 'outbound',
            'default_partner_type': 'supplier',
            'default_move_journal_types': ['cash'],
            'search_default_cash_filter': 1
        }</field>
    </record>
    <menuitem id="menu_cash_payments"
              name="Operations de caisse"
              parent="account.menu_finance_entries"
              action="action_cash_payments"
              sequence="5"/>
    <record id="account.action_view_bank_statement_tree" model="ir.actions.act_window">
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('journal_id.type', '=', 'cash')]</field>
        <field name="context">{
            'default_payment_type': 'outbound',
            'default_partner_type': 'supplier',
            'default_move_journal_types': ['cash'],
            'search_default_cash_filter': 1
        }</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_cash_payment_list')})]"/>
    </record>
    <record id="action_lettrer_caisse" model="ir.actions.act_window">
        <field name="name">Lettrer caisse</field>
        <field name="res_model">account.bank.statement.line</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('journal_id.type', '=', 'cash')]</field>
        <field name="context">{'view_ref': 'account_reconcile_oca.bank_statement_line_form_reconcile_view'}</field>
    </record>
    <menuitem id="menu_lettrer_caisse"
              name="Lettrer caisse"
              parent="account.menu_finance_entries"
              action="action_lettrer_caisse"
              sequence="6"/>
</odoo>
